# Copy to .env.local for local dev. Never prefix these with VITE_.
# DECIDER: jev | groq | openrouter | ev
DECIDER=ev
# Optional: engine to try if DECIDER fails, and the time (ISO, with offset)
# from which only DECIDER_NEXT is used, e.g. 2026-09-24T23:00:00+01:00
DECIDER_NEXT=
DECIDER_SWITCH_AT=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Optional: comma-separated free model IDs, tried in order
# (default nvidia/nemotron-3-super-120b-a12b:free,openrouter/free)
OPENROUTER_MODEL=
# Vercel AI Gateway key (vck_...) for DECIDER=jev
AI_GATEWAY_API_KEY=
